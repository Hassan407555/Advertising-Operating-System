generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// EXISTING MODELS (with minimal additions)
// ============================================

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique @db.VarChar(100)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  auditLogs   AuditLog[]   @relation("OrganizationAuditLogs")
  invitations Invitation[]
  memberships Membership[]

  // NEW RELATIONS
  platformConnections PlatformConnection[]
  analyticsSnapshots  AnalyticsSnapshot[]
  adAccounts          AdAccount[]
  campaigns           Campaign[]
  adSets              AdSet[]
  ads                 Ad[]
  creatives           Creative[]
  creativeAssets      CreativeAsset[]
  apiKeys             ApiKey[]
  reports             Report[]
  reportSchedules     ReportSchedule[]
  shopifyProducts     ShopifyProduct[]
  automationPipelines AutomationPipeline[]
  automationRuns      AutomationRun[]
  automationSteps     AutomationStep[]
  publishJobs         PublishJob[]
  storeAdvertisingConfigurations StoreAdvertisingConfiguration[]
  aiSessions                     AiSession[]
}

model User {
  id                     String       @id @default(cuid())
  email                  String       @unique @db.VarChar(254)
  passwordHash           String
  firstName              String
  lastName               String
  status                 UserStatus   @default(ACTIVE)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  refreshTokenHash       String?
  avatarUrl              String?
  bio                    String?
  emailVerifiedAt        DateTime?
  jobTitle               String?
  language               String?      @default("en") @db.VarChar(10)
  lastLoginAt            DateTime?
  passwordResetExpiresAt DateTime?
  passwordResetTokenHash String?
  phone                  String?
  timezone               String?      @default("UTC") @db.VarChar(50)
  auditLogs              AuditLog[]   @relation("UserAuditLogs")
  createdInvitations     Invitation[] @relation("InvitationCreator")
  memberships            Membership[]

  // NEW RELATIONS
  createdPlatformConnections PlatformConnection[] @relation("PlatformConnectionCreator")
  apiKeys                    ApiKey[]
  createdReports             Report[]             @relation("ReportCreator")
  requestedPublishJobs       PublishJob[]         @relation("PublishJobRequester")
  createdAiSessions          AiSession[]          @relation("AiSessionCreator")
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([organizationId, role])
}

model Invitation {
  id              String           @id @default(cuid())
  organizationId  String
  email           String           @db.VarChar(254)
  role            MembershipRole   @default(MEMBER)
  status          InvitationStatus @default(PENDING)
  tokenHash       String           @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser   User             @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, email, status])
  @@index([organizationId, expiresAt])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String
  action         AuditAction
  entity         AuditEntity
  entityId       String?
  metadata       Json?
  ipAddress      String?      @db.VarChar(45)
  userAgent      String?
  createdAt      DateTime     @default(now())
  actor          User         @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)
  organization   Organization @relation("OrganizationAuditLogs", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

