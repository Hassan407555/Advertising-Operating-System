model PlatformConnection {
  id                   String           @id @default(cuid())
  organizationId       String
  createdByUserId      String
  platform             PlatformType
  accountId            String           @db.VarChar(255)
  accountName          String           @db.VarChar(255)
  externalName         String?          @db.VarChar(255)
  status               ConnectionStatus @default(ACTIVE)
  syncStatus           SyncStatus       @default(SYNCED)
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  webhookSecret        String?
  webhookUrl           String?
  metadata             Json?
  deletedAt            DateTime?
  version              Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PlatformConnectionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  credentials     PlatformCredential[]
  adAccounts      AdAccount[]
  shopifyProducts ShopifyProduct[]
  shopifyAdvertisingConfiguration StoreAdvertisingConfiguration? @relation("ShopifyStoreAdvertisingConfig")
  metaAdvertisingConfigurations   StoreAdvertisingConfiguration[] @relation("MetaStoreAdvertisingConfig")
  aiSessions                      AiSession[]
  campaigns                       Campaign[] @relation("CampaignShopifyStore")

  @@unique([organizationId, platform, accountId])
  @@index([organizationId, deletedAt])
  @@index([organizationId])
  @@index([platform])
  @@index([status])
  @@index([syncStatus])
  @@index([deletedAt])
}

model PlatformCredential {
  id                   String    @id @default(cuid())
  platformConnectionId String
  accessToken          String    @db.Text // Encrypted
  refreshToken         String?   @db.Text // Encrypted
  expiresAt            DateTime?
  scopes               String[]  @db.VarChar(100)
  isActive             Boolean   @default(true)
  revokedAt            DateTime?
  revokedReason        String?   @db.VarChar(255)
  rotatedAt            DateTime?
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  platformConnection PlatformConnection @relation(fields: [platformConnectionId], references: [id], onDelete: Cascade)

  @@index([platformConnectionId])
  @@index([isActive])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AdAccount {
  id                   String          @id @default(cuid())
  organizationId       String
  platformConnectionId String
  platform             PlatformType
  externalId           String          @db.VarChar(255)
  externalName         String?         @db.VarChar(255) // Renamed
  externalStatus       String?         @db.VarChar(50) // Renamed
  accountName          String          @db.VarChar(255)
  accountNumber        String?         @db.VarChar(100)
  currency             Currency        @default(USD)
  timezone             String          @db.VarChar(50)
  status               AdAccountStatus @default(ACTIVE)
  isActive             Boolean         @default(true)
  spend                Decimal?        @db.Decimal(18, 2)
  impressions          Int?
  clicks               Int?
  conversions          Decimal?        @db.Decimal(18, 2)
  deletedAt            DateTime?
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  metadata             Json?
  version              Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platformConnection PlatformConnection @relation(fields: [platformConnectionId], references: [id], onDelete: Restrict)
  campaigns          Campaign[]
  publishJobs        PublishJob[]
  storeAdvertisingConfigurations StoreAdvertisingConfiguration[]

  @@unique([organizationId, platformConnectionId, externalId])
  @@unique([platformConnectionId, externalId])
  @@index([organizationId, deletedAt])
  @@index([organizationId])
  @@index([platformConnectionId])
  @@index([platform])
  @@index([status])
  @@index([externalId])
  @@index([deletedAt])
  @@index([isActive])
}

model Campaign {
  id                   String             @id @default(cuid())
  organizationId       String // RESTORED for fast tenant filtering
  adAccountId          String
  shopifyStoreId       String?
  externalId           String             @db.VarChar(255)
  externalName         String?            @db.VarChar(255) // Renamed
  externalStatus       String?            @db.VarChar(50) // Renamed
  name                 String             @db.VarChar(255)
  slug                 String?            @db.VarChar(100) // Optional for nice URLs
  objective            CampaignObjective
  status               CampaignStatus     @default(DRAFT)
  buyingType           CampaignBuyingType @default(AUCTION)
  dailyBudget          Decimal?           @db.Decimal(18, 2)
  lifetimeBudget       Decimal?           @db.Decimal(18, 2)
  currency             Currency           @default(USD)
  startDate            DateTime?
  endDate              DateTime?
  isActive             Boolean            @default(true)
  spend                Decimal?           @db.Decimal(18, 2)
  impressions          Int?
  clicks               Int?
  conversions          Decimal?           @db.Decimal(18, 2)
  deletedAt            DateTime?
  archivedAt           DateTime? // Separate from status
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  metadata             Json?
  tags                 Json? // For flexible categorization
  version              Int                @default(1)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adAccount          AdAccount           @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  shopifyStore       PlatformConnection? @relation("CampaignShopifyStore", fields: [shopifyStoreId], references: [id], onDelete: SetNull)
  adSets             AdSet[]
  analyticsSnapshots AnalyticsSnapshot[]
  publishJobs        PublishJob[]

  // Active-row uniqueness enforced via partial unique indexes in SQL
  // (WHERE deletedAt IS NULL) — see migration soft_delete_partial_uniques.
  @@index([organizationId, adAccountId, externalId])
  @@index([adAccountId, externalId])
  @@index([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@index([organizationId])
  @@index([organizationId, shopifyStoreId])
  @@index([shopifyStoreId])
  @@index([adAccountId])
  @@index([status])
  @@index([objective])
  @@index([externalId])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
  @@index([isActive])
  @@index([archivedAt])
}

model AdSet {
  id                   String        @id @default(cuid())
  organizationId       String // RESTORED
  campaignId           String
  externalId           String        @db.VarChar(255)
  externalName         String?       @db.VarChar(255) // Renamed
  externalStatus       String?       @db.VarChar(50) // Renamed
  name                 String        @db.VarChar(255)
  status               AdSetStatus   @default(DRAFT)
  dailyBudget          Decimal?      @db.Decimal(18, 2)
  lifetimeBudget       Decimal?      @db.Decimal(18, 2)
  bidAmount            Decimal?      @db.Decimal(18, 2)
  billingEvent         BillingEvent?
  targeting            Json? // Platform-specific targeting (will be normalized later)
  startDate            DateTime?
  endDate              DateTime?
  isActive             Boolean       @default(true)
  spend                Decimal?      @db.Decimal(18, 2)
  impressions          Int?
  clicks               Int?
  conversions          Decimal?      @db.Decimal(18, 2)
  deletedAt            DateTime?
  archivedAt           DateTime?
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  metadata             Json?
  tags                 Json?
  version              Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads                Ad[]
  analyticsSnapshots AnalyticsSnapshot[]

  // Active-row uniqueness enforced via partial unique indexes in SQL
  // (WHERE deletedAt IS NULL) — see migration soft_delete_partial_uniques.
  @@index([organizationId, campaignId, externalId])
  @@index([campaignId, externalId])
  @@index([organizationId, deletedAt])
  @@index([organizationId])
  @@index([campaignId])
  @@index([status])
  @@index([externalId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([archivedAt])
}

model Ad {
  id                   String    @id @default(cuid())
  organizationId       String // RESTORED
  adSetId              String
  creativeId           String?
  externalId           String    @db.VarChar(255)
  externalName         String?   @db.VarChar(255) // Renamed
  externalStatus       String?   @db.VarChar(50) // Renamed
  name                 String    @db.VarChar(255)
  status               AdStatus  @default(DRAFT)
  isActive             Boolean   @default(true)
  spend                Decimal?  @db.Decimal(18, 2)
  impressions          Int?
  clicks               Int?
  conversions          Decimal?  @db.Decimal(18, 2)
  deletedAt            DateTime?
  archivedAt           DateTime?
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  metadata             Json?
  tags                 Json?
  version              Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adSet              AdSet               @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  creative           Creative?           @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  assets             CreativeAsset[]
  analyticsSnapshots AnalyticsSnapshot[]

  // Active-row uniqueness enforced via partial unique indexes in SQL
  // (WHERE deletedAt IS NULL) — see migration soft_delete_partial_uniques.
  @@index([organizationId, adSetId, externalId])
  @@index([adSetId, externalId])
  @@index([organizationId, deletedAt])
  @@index([organizationId])
  @@index([adSetId])
  @@index([status])
  @@index([externalId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([archivedAt])
}

model Creative {
  id                   String        @id @default(cuid())
  organizationId       String
  externalId           String?       @db.VarChar(255)
  externalName         String?       @db.VarChar(255) // Renamed
  name                 String        @db.VarChar(255)
  type                 CreativeType
  headline             String?       @db.VarChar(255)
  primaryText          String?       @db.Text
  description          String?       @db.Text
  callToAction         CallToAction?
  landingPageUrl       String?       @db.VarChar(2000)
  deepLinkUrl          String?       @db.VarChar(2000)
  isActive             Boolean       @default(true)
  deletedAt            DateTime?
  archivedAt           DateTime?
  lastSyncedAt         DateTime?
  lastSuccessfulSyncAt DateTime?
  lastFailedSyncAt     DateTime?
  metadata             Json?
  tags                 Json?
  version              Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ads                Ad[]
  assets             CreativeAsset[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@index([organizationId, deletedAt])
  @@index([organizationId])
  @@index([type])
  @@index([externalId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([archivedAt])
}

model CreativeAsset {
  id String @id @default(cuid())

  organizationId String
  creativeId     String?
  adId           String?

  assetType CreativeAssetType

  storageProvider StorageProvider @default(LOCAL)

  fileName         String @db.VarChar(255)
  originalFileName String @db.VarChar(255)

  storageKey String @db.VarChar(1000)

  url          String  @db.VarChar(2000)
  thumbnailUrl String? @db.VarChar(2000)

  mimeType  String @db.VarChar(255)
  extension String @db.VarChar(20)

  checksum String? @db.VarChar(128)

  width  Int?
  height Int?

  fileSize BigInt? @default(0)

  duration Decimal? @db.Decimal(10, 3)

  displayOrder Int @default(0)

  isPrimary Boolean @default(false)

  metadata Json?

  deletedAt  DateTime?
  archivedAt DateTime?

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creative     Creative?    @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  ad           Ad?          @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([organizationId, creativeId])
  @@index([creativeId])
  @@index([adId])
  @@index([assetType])
  @@index([storageProvider])
  @@index([isPrimary])
  @@index([displayOrder])
  @@index([deletedAt])
  @@index([archivedAt])
}

model AnalyticsSnapshot {
  id String @id @default(cuid())

  // Tenant
  organizationId String

  // Platform
  platform PlatformType

  // Snapshot Type
  level AnalyticsLevel

  // Relations
  campaignId String?
  adSetId    String?
  adId       String?
  creativeId String?

  // Deterministic grain key (COALESCE-safe uniqueness across nullable FKs)
  uniqueKey String @unique @db.VarChar(512)

  // Date
  snapshotDate DateTime @db.Date

  // Currency
  currency Currency @default(USD)

  // Delivery
  impressions Int @default(0)
  reach       Int @default(0)
  clicks      Int @default(0)
  linkClicks  Int @default(0)

  // Cost
  spend Decimal  @default(0) @db.Decimal(18, 2)
  cpc   Decimal? @db.Decimal(18, 4)
  cpm   Decimal? @db.Decimal(18, 4)
  ctr   Decimal? @db.Decimal(8, 4)

  // Conversion
  conversions     Decimal? @db.Decimal(18, 4)
  conversionValue Decimal? @db.Decimal(18, 2)

  // Revenue
  revenue Decimal? @db.Decimal(18, 2)
  roas    Decimal? @db.Decimal(18, 4)

  // Video
  videoViews Int @default(0)

  // Flexible platform metrics
  platformMetrics Json?

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  adSet AdSet? @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  ad Ad? @relation(fields: [adId], references: [id], onDelete: Cascade)

  creative Creative? @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([snapshotDate])
  @@index([platform])
  @@index([level])
  @@index([campaignId])
  @@index([adSetId])
  @@index([adId])
  @@index([creativeId])
  @@index([organizationId, snapshotDate])
  @@index([organizationId, platform, snapshotDate])
}

model ApiKey {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  name           String     @db.VarChar(100)
  keyHash        String     @unique
  role           ApiKeyRole @default(READ)
  permissions    Json? // Flexible permissions
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean    @default(true)
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name, deletedAt])
  @@index([organizationId, deletedAt])
  @@index([organizationId])
  @@index([userId])
  @@index([isActive])
  @@index([deletedAt])
}

model Report {
  id String @id @default(cuid())

  organizationId  String
  createdByUserId String

  name        String  @db.VarChar(255)
  description String? @db.VarChar(500)

  level ReportLevel

  platform PlatformType?

  format ReportFormat @default(CSV)

  filters Json?
  columns Json?

  isDefault Boolean @default(false)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdBy User @relation("ReportCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  schedules ReportSchedule[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([createdByUserId])
}

model ReportSchedule {
  id String @id @default(cuid())

  organizationId String
  reportId       String

  frequency ReportFrequency

  timezone String @default("UTC") @db.VarChar(50)

  recipients Json?

  isEnabled Boolean @default(true)

  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([reportId])
  @@index([isEnabled])
  @@index([nextRunAt])
}

// ============================================
// AUTOMATION ENGINE
// ============================================

enum AutomationTriggerType {
  NEW_PRODUCT
  MANUAL_LAUNCH
  SCHEDULED_LAUNCH
}

enum AutomationActionType {
  GENERATE_CAMPAIGN
  GENERATE_AI_COPY
  PROCESS_MEDIA
  PUBLISH_CAMPAIGN
  SYNCHRONIZE_CAMPAIGN
  SEND_NOTIFICATION
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AutomationStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum PublishJobStatus {
  PENDING
  VALIDATING
  PUBLISHING
  COMPLETED
  PARTIAL
  FAILED
}

model AutomationPipeline {
  id              String                @id @default(cuid())
  organizationId  String
  createdByUserId String
  name            String                @db.VarChar(255)
  description     String?               @db.VarChar(500)
  triggerType     AutomationTriggerType
  triggerConfig   Json?
  actions         Json
  isEnabled       Boolean               @default(true)
  deletedAt       DateTime?
  version         Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([triggerType])
  @@index([isEnabled])
  @@index([deletedAt])
}

model AutomationRun {
  id                 String                @id @default(cuid())
  organizationId     String
  pipelineId         String
  triggerType        AutomationTriggerType
  status             AutomationRunStatus   @default(PENDING)
  triggeredByUserId  String?
  startedAt          DateTime?
  completedAt        DateTime?
  errorMessage       String?               @db.VarChar(1000)
  metadata           Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     AutomationPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  steps        AutomationStep[]

  @@index([organizationId])
  @@index([pipelineId])
  @@index([status])
  @@index([triggerType])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, pipelineId])
  @@index([organizationId, status])
}

model AutomationStep {
  id             String               @id @default(cuid())
  organizationId String
  runId          String
  actionType     AutomationActionType
  stepOrder      Int
  status         AutomationStepStatus @default(PENDING)
  input          Json?
  output         Json?
  errorMessage   String?              @db.VarChar(1000)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  run          AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([runId, stepOrder])
  @@index([organizationId])
  @@index([runId])
  @@index([status])
  @@index([actionType])
}

model PublishJob {
  id                String           @id @default(cuid())
  organizationId    String
  campaignId        String
  adAccountId       String
  platform          PlatformType
  status            PublishJobStatus @default(PENDING)
  dryRun            Boolean          @default(false)
  requestedByUserId String?
  errorMessage      String?          @db.VarChar(2000)
  request           Json?
  result            Json?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign        Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  adAccount       AdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  requestedByUser User?        @relation("PublishJobRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campaignId])
  @@index([adAccountId])
  @@index([platform])
  @@index([status])
  @@index([organizationId, campaignId])
  @@index([organizationId, createdAt])
}

// ============================================
// STORE ADVERTISING CONFIGURATION
// Shopify store ↔ Meta advertising resource IDs (no display-name duplication)
// ============================================

model StoreAdvertisingConfiguration {
  id             String @id @default(cuid())
  organizationId String

  /// Shopify PlatformConnection id for this store
  shopifyStoreId String @unique

  /// Optional Meta PlatformConnection used for this store
  metaPlatformConnectionId String?

  /// External Meta Business Manager ID
  metaBusinessId String? @db.VarChar(255)

  /// Local AdAccount row selected for this store
  adAccountId String?

  /// External Meta resource IDs only
  facebookPageId     String? @db.VarChar(255)
  instagramAccountId String? @db.VarChar(255)
  pixelId            String? @db.VarChar(255)
  catalogId          String? @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopifyStore           PlatformConnection  @relation("ShopifyStoreAdvertisingConfig", fields: [shopifyStoreId], references: [id], onDelete: Cascade)
  metaPlatformConnection PlatformConnection? @relation("MetaStoreAdvertisingConfig", fields: [metaPlatformConnectionId], references: [id], onDelete: SetNull)
  adAccount              AdAccount?          @relation(fields: [adAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([metaPlatformConnectionId])
  @@index([adAccountId])
}

model ShopifyProduct {
  id String @id @default(cuid())

  organizationId       String
  platformConnectionId String

  externalId String @db.VarChar(255)

  title  String @db.VarChar(255)
  handle String @db.VarChar(255)

  vendor      String? @db.VarChar(255)
  productType String? @db.VarChar(255)

  description String? @db.Text

  status ShopifyProductStatus @default(ACTIVE)

  tags String[]

  featuredImageUrl String? @db.VarChar(2000)

  metadata Json?

  deletedAt DateTime?

  lastSyncedAt DateTime?

  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  platformConnection PlatformConnection @relation(fields: [platformConnectionId], references: [id], onDelete: Cascade)

  variants ShopifyVariant[]

  images ShopifyImage[]

  aiSessions AiSession[]

  @@unique([platformConnectionId, externalId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([platformConnectionId])
  @@index([externalId])
  @@index([status])
  @@index([deletedAt])
}

model ShopifyVariant {
  id String @id @default(cuid())

  productId String

  externalId String @db.VarChar(255)

  title String? @db.VarChar(255)

  sku String? @db.VarChar(100)

  barcode String? @db.VarChar(100)

  price Decimal? @db.Decimal(18, 2)

  compareAtPrice Decimal? @db.Decimal(18, 2)

  inventoryQuantity Int?

  option1 String? @db.VarChar(255)
  option2 String? @db.VarChar(255)
  option3 String? @db.VarChar(255)

  weight Decimal? @db.Decimal(10, 3)

  isDefault Boolean @default(false)

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId])
  @@index([productId])
  @@index([sku])
}

model ShopifyImage {
  id String @id @default(cuid())

  productId String

  externalId String @db.VarChar(255)

  url String @db.VarChar(2000)

  alt String? @db.VarChar(500)

  width  Int?
  height Int?

  displayOrder Int @default(0)

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  product   ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, externalId])
  @@index([productId])
}

// ============================================
// AI SESSION (workflow engine backbone)
// ============================================

enum AiSessionStatus {
  CREATED
  AWAITING_INPUT
  INTERVIEWING
  READY_FOR_ANALYSIS
  ANALYZING
  PLANNING
  BUILDING
  REVIEWING
  AWAITING_APPROVAL
  APPROVED
  FAILED
  CANCELLED
  ARCHIVED
}

enum AiSessionMessageRole {
  SYSTEM
  ASSISTANT
  USER
}

enum AiSessionSource {
  PRODUCT_PAGE
}

model AiSession {
  id             String @id @default(cuid())
  organizationId String
  shopifyStoreId String
  productId      String
  createdByUserId String

  /// Entry point that created this session (preserved on resume).
  sessionSource  AiSessionSource @default(PRODUCT_PAGE)

  status         AiSessionStatus @default(CREATED)
  currentManager String          @db.VarChar(100)
  currentPhase   String          @db.VarChar(100)

  /// Immutable workflow engine metadata (definition id, step catalog, etc.)
  workflowMetadata Json

  /// Mutable workflow context (step pointer, collected answers)
  workflowContext Json

  /// Engine version for this session
  workflowVersion String @db.VarChar(50)

  /// Prompt template versions recorded for managers used in this session
  promptVersions Json

  errorMessage   String?   @db.VarChar(2000)
  lastActivityAt DateTime  @default(now())
  completedAt    DateTime?
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopifyStore PlatformConnection @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)
  product      ShopifyProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("AiSessionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  messages     AiSessionMessage[]

  @@index([organizationId])
  @@index([shopifyStoreId])
  @@index([productId])
  @@index([organizationId, shopifyStoreId, productId])
  @@index([organizationId, status])
  @@index([createdByUserId])
  @@index([lastActivityAt])
}

model AiSessionMessage {
  id        String               @id @default(cuid())
  sessionId String
  role      AiSessionMessageRole
  content   String               @db.Text
  stepKey   String?              @db.VarChar(100)
  metadata  Json?
  createdAt DateTime             @default(now())

  session AiSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
}
