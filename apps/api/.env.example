# AI Meta Ads Studio — API environment template
# Copy to apps/api/.env and replace placeholder values before starting the API.
#
# Local pairing with the web app:
#   API  -> http://localhost:3001/api
#   Web  -> http://localhost:3000  (NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api)
#
# JWT_SECRET and REFRESH_TOKEN_SECRET must be at least 32 characters.
# CORS_ORIGIN cannot be "*" when NODE_ENV=production.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Local Docker Postgres (docker-compose.dev.yml maps host 5433 → container 5432)
DATABASE_URL=postgresql://aos:aos_dev_password@localhost:5433/advertising_os?schema=public

# JWT / session (required)
JWT_SECRET=change-me-access-token-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Used for encrypting platform credentials (required, min 32 chars)
ENCRYPTION_KEY=change-me-encryption-key-32chars!!

# Auth rate limiting (optional; defaults applied if omitted)
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000

# CORS — comma-separated browser origins allowed to call the API.
# Include every local web port you use (Next may fall back to 3002 if 3000 is busy).
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002

# Swagger (defaults to enabled outside production)
SWAGGER_ENABLED=true

# Invitations (optional; default 168 hours)
INVITATION_EXPIRATION_HOURS=168

# Frontend origin for password-reset and invitation links (optional; falls back to first CORS_ORIGIN)
# WEB_APP_URL=http://localhost:3000

# Invitation emails use InvitationEmailService (LocalEmailProvider logs the invite URL).
# Swap the INVITATION_EMAIL_SERVICE binding for SMTP / SendGrid / Resend / SES later.

# Shopify OAuth (required by env validation even if unused in a local session)
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_REDIRECT_URI=http://localhost:3001/api/shopify/callback

# Meta / Facebook OAuth (Marketing API)
# Register this exact redirect URI in the Meta Developer App → Facebook Login → Settings
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:3001/api/meta/callback
META_GRAPH_API_VERSION=v23.0
# Local Meta simulator (no Graph API). Defaults on in NODE_ENV=development.
# Set META_TEST_MODE=false to hit real Meta while developing.
META_TEST_MODE=true
# Optional: frontend origin used after OAuth callback (defaults to first CORS_ORIGIN)
# WEB_APP_URL=http://localhost:3000

# AI provider (switch via AI_PROVIDER only — GEMINI | GROQ)
# GEMINI requires GEMINI_API_KEY; GROQ requires GROQ_API_KEY
AI_PROVIDER=GEMINI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# Optional fallback chain, e.g. GROQ when Gemini fails (non-4xx)
# AI_FALLBACK_PROVIDERS=GROQ
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_BASE_URL=https://api.groq.com/openai/v1
AI_TEMPERATURE=0.7
# Default max tokens; Phase 6 campaign generation requests 4096 per call
AI_MAX_OUTPUT_TOKENS=2048

# Storage (optional; local provider is default)
STORAGE_PROVIDER=local
